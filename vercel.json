{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/sendOtp.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "server/sendOtp.ts": {
      "runtime": "@vercel/node@18"
    }
  }
}